    {
      "parameters": {
        "jsCode": "// Нові ліди: рядки без позначки в стовпці «Telegram», починаючи з рядка startRow.\nconst cfg = $('Налаштування').first().json;\nconst startRow = Number(cfg.startRow) || 2;\nconst MAX_PER_RUN = 20; // решта піде наступної хвилини\n\n// Підписи для типових стовпців Meta Lead Ads. Інші стовпці показуються під своїми назвами.\nconst LABELS = {\n  created_time: '🕘 Створено',\n  full_name: \"👤 Ім'я\", first_name: \"👤 Ім'я\", last_name: '👤 Прізвище',\n  phone_number: '📞 Телефон', phone: '📞 Телефон', email: '✉️ Email',\n  city: '🏙 Місто', country: '📍 Країна',\n  campaign_name: '📣 Кампанія', adset_name: '📣 Група оголошень', ad_name: '📣 Оголошення',\n  form_name: '📝 Форма', platform: '📱 Платформа',\n};\n// Службові стовпці, які в повідомленні не потрібні.\nconst SKIP = new Set(['row_number', 'Telegram', 'Статус', 'Обновил', 'Обновлено',\n  'id', 'ad_id', 'adset_id', 'campaign_id', 'form_id', 'is_organic']);\n\nconst clean = (key, value) => {\n  const text = String(value).replace(/^p:/, '').trim(); // Meta додає \"p:\" перед телефоном\n  if (key === 'created_time') {\n    const date = DateTime.fromISO(text);\n    if (date.isValid) return date.toFormat('dd.MM.yyyy HH:mm');\n  }\n  return text;\n};\nconst filled = ([key, value]) => !SKIP.has(key) && String(value ?? '').trim() !== '';\n\nconst leads = $input.all()\n  .map(item => item.json)\n  .filter(row => row.row_number >= startRow && String(row['Telegram'] ?? '').trim() === '')\n  .filter(row => Object.entries(row).some(filled))\n  .slice(0, MAX_PER_RUN);\n\nreturn leads.map(row => {\n  const lines = Object.entries(row)\n    .filter(filled)\n    .map(([key, value]) => `${LABELS[key] || key}: ${clean(key, value)}`);\n  return { json: { row_number: row.row_number, text: '🔥 Новий лід\\n\\n' + lines.join('\\n') } };\n});\n"
      },
