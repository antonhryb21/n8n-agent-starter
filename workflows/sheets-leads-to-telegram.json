    {
      "parameters": {
        "jsCode": "// Нові ліди: рядки без позначки в стовпці «Telegram», починаючи з рядка startRow.\nconst cfg = $('Налаштування').first().json;\nconst startRow = Number(cfg.startRow) || 2;\nconst MAX_PER_RUN = 20; // решта піде наступної хвилини\n\n// Підписи для типових стовпців Meta Lead Ads. Інші стовпці показуються під своїми назвами.\nconst LABELS = {\n  full_name: \"Ім'я\", first_name: \"Ім'я\", last_name: 'Прізвище',\n  phone_number: 'Телефон', phone: 'Телефон', email: 'Email',\n  city: 'Місто', created_time: 'Створено',\n  campaign_name: 'Кампанія', adset_name: 'Група оголошень', ad_name: 'Оголошення',\n  form_name: 'Форма', platform: 'Платформа',\n};\n// Технічні стовпці, які в повідомленні не потрібні.\nconst SKIP = new Set(['row_number', 'Telegram', 'id', 'ad_id', 'adset_id', 'campaign_id', 'form_id', 'is_organic']);\n\nconst clean = value => String(value).replace(/^p:/, '').trim(); // Meta додає \"p:\" перед телефоном\n\nconst leads = $input.all()\n  .map(item => item.json)\n  .filter(row => row.row_number >= startRow && String(row['Telegram'] ?? '').trim() === '')\n  .filter(row => Object.entries(row).some(([k, v]) => !SKIP.has(k) && String(v ?? '').trim() !== ''))\n  .slice(0, MAX_PER_RUN);\n\nreturn leads.map(row => {\n  const lines = Object.entries(row)\n    .filter(([key, value]) => !SKIP.has(key) && String(value ?? '').trim() !== '')\n    .map(([key, value]) => `${LABELS[key] || key}: ${clean(value)}`);\n  return { json: { row_number: row.row_number, text: '🔥 Новий лід\\n\\n' + lines.join('\\n') } };\n});\n"
      },
      "id": "fbe6df8c-357e-5fb1-bb67-4f3eb670150b",
      "name": "Нові ліди",
