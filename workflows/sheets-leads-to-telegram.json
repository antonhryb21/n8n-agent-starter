    {
      "parameters": {
        "jsCode": "// Натискання кнопки статусу: callback_data = \"st|<номер рядка>|<код статусу>\".\nconst STATUS = {\n  contacted: 'Contacted',\n  qualified: 'Lead (Qualified)',\n  no_answer: 'No answer',\n  follow_up: 'Follow-up',\n  job: 'Job inquiry',\n  not_relevant: 'Not relevant',\n  spam: 'Spam',\n  supplier: 'Supplier',\n};\nconst q = $('Повідомлення боту').first().json.callback_query;\nconst [, row, code] = String(q.data || '').split('|');\nconst status = STATUS[code] || code;\nconst who = q.from.username ? '@' + q.from.username : [q.from.first_name, q.from.last_name].filter(Boolean).join(' ');\nconst when = $now.toFormat('dd.MM.yyyy HH:mm');\n\n// Текст ліда без попереднього блоку статусу + новий блок.\nconst leadText = String(q.message?.text || '').split('\\n\\n📋 Статус:')[0];\nconst text = `${leadText}\\n\\n📋 Статус: ${status}\\n👤 Обновил: ${who}\\n🕘 Обновлено: ${when}`;\n\nreturn [{ json: {\n  row_number: Number(row), status, who, when, text,\n  chatId: q.message.chat.id, messageId: q.message.message_id, queryId: q.id,\n} }];\n"
      },
