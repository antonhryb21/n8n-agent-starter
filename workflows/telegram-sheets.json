    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "54208e5a-df3c-5513-986a-6c513cd62629",
              "name": "reply",
              "value": "=Привіт! Я записую твої повідомлення в Google Таблицю.\n\n• Надішли будь-який текст, і я додам його новим рядком.\n• /list покаже 5 твоїх останніх записів.\n• /help покаже цю підказку.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "5f8709b5-46a4-5cce-8d6c-53f2c7c6d6f1",
      "name": "Підказка",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        700,
        140
      ]
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $('Налаштування').first().json.sheetUrl }}",
          "mode": "url"
        },
        "sheetName": {
          "__rl": true,
          "value": "={{ $('Налаштування').first().json.sheetName }}",
          "mode": "name"
        },
        "filtersUI": {},
        "options": {}
      },
      "id": "82cb0533-fed6-523f-a6a0-c7f6ebc6e923",
      "name": "Прочитати рядки",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        700,
        280
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Беремо лише рядки цього чату і показуємо 5 останніх.\nconst chatId = String($('Telegram Trigger').first().json.message.chat.id);\nconst rows = $input.all()\n  .map(item => item.json)\n  .filter(row => row['Текст'] !== undefined && String(row['Chat ID']) === chatId);\n\nif (rows.length === 0) {\n  return [{ json: { reply: 'У таблиці поки немає твоїх записів. Надішли мені будь-який текст.' } }];\n}\n\nconst lines = rows.slice(-5).map(row => `• ${row['Дата']}: ${row['Текст']}`);\nreturn [{ json: { reply: 'Твої останні записи:\\n' + lines.join('\\n') } }];\n"
      },
      "id": "c85bbafb-aca4-5e85-8180-e76bfaab84b3",
      "name": "Останні записи",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        280
      ]
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "={{ $('Налаштування').first().json.sheetUrl }}",
          "mode": "url"
        },
        "sheetName": {
          "__rl": true,
          "value": "={{ $('Налаштування').first().json.sheetName }}",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Дата": "={{ $now.toFormat('yyyy-MM-dd HH:mm') }}",
            "Chat ID": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
            "Користувач": "={{ [$('Telegram Trigger').item.json.message.from.first_name, $('Telegram Trigger').item.json.message.from.last_name].filter(Boolean).join(' ') }}",
            "Username": "={{ $('Telegram Trigger').item.json.message.from.username ? '@' + $('Telegram Trigger').item.json.message.from.username : '' }}",
            "Текст": "={{ $('Telegram Trigger').item.json.message.text }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "Дата",
              "displayName": "Дата",
