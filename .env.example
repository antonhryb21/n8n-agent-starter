# Скопіюй цей файл у .env (це робить scripts/setup.sh) і заповни значення.
# .env ніколи не потрапляє в git.

# --- Telegram ---
# Токен бота від @BotFather. СЕКРЕТ.
TELEGRAM_BOT_TOKEN=

# --- Тунель ---
# Який тунель запускати: ngrok | cloudflare-quick | cloudflare-named
# Docker Compose читає цю змінну і вмикає потрібний сервіс.
COMPOSE_PROFILES=ngrok

# ngrok (основний). Authtoken: СЕКРЕТ. Домен: твій dev domain, напр. name.ngrok-free.app
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Cloudflare Named Tunnel (опція з власним доменом). Токен: СЕКРЕТ.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_HOSTNAME=

# --- n8n ---
# Публічна адреса для webhook. Заповнюють скрипти автоматично.
WEBHOOK_URL=
# Ключ шифрування credentials у n8n. Генерує setup.sh. СЕКРЕТ, не губи.
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=Europe/Kyiv
